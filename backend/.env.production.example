NODE_ENV=production
PORT=8000
S_URL=https://YOUR_PROJECT.supabase.co
S_ANON=YOUR_SUPABASE_PUBLIC_KEY
S_SERV=YOUR_SUPABASE_SECRET_KEY
G_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
PASSWORD_RESET_URL=https://YOUR_WEB_HOST/reset-password
CORS_ORIGINS=https://YOUR_WEB_HOST
# Set to 1 only when the hosting provider places exactly one trusted proxy in front of this server.
TRUST_PROXY_HOPS=0
# Required only if enabling the legacy 2FA/integration secret store.
# ENCRYPTION_KEY= (random secret of at least 32 characters; never expose it to clients)
