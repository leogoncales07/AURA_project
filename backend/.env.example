G_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
# Set both flags as shown in .env.school.example during presentations involving minors.
AURA_SCHOOL_DEMO=false
S_URL=your_supabase_url_here
S_ANON=your_supabase_anon_key_here
S_SERV=your_supabase_service_role_key_here
PASSWORD_RESET_URL=http://127.0.0.1:3000/reset-password
# Production: https://aura.pt/reset-password (after domain ownership and hosting setup)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development
PORT=8000
TRUST_PROXY_HOPS=0
O_PASS=your_custom_owner_secret_here
# Optional: only for the legacy 2FA/integration secret store. No built-in default.
# ENCRYPTION_KEY= (generate a random secret of at least 32 characters; keep it server-side)
